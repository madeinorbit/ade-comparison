{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ade-comparison:research",
  "title": "ADE product profile",
  "description": "Research record. Structural validation plus validate.mjs semantic checks are required before use.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "rubricVersion": {
      "const": "0.3"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "unassigned"
      ]
    },
    "researchTier": {
      "enum": [
        "full-profile",
        "qualification",
        "watch"
      ]
    },
    "researchState": {
      "enum": [
        "queued",
        "researching",
        "documented",
        "reviewed"
      ]
    },
    "identity": {
      "type": "object",
      "properties": {
        "website": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(https?://[^\\s]+|internal-file:[^\\s]+)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "repository": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(https?://[^\\s]+|internal-file:[^\\s]+)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "company": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "website",
        "repository",
        "aliases",
        "company"
      ],
      "additionalProperties": false
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "type"
        ],
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "criterionId": {
            "type": "string",
            "minLength": 1
          },
          "answer": {
            "type": "string",
            "minLength": 1
          },
          "support": {
            "enum": [
              "supported",
              "partial",
              "unsupported",
              "unknown",
              "not-applicable"
            ]
          },
          "availability": {
            "enum": [
              "generally-available",
              "beta",
              "private-preview",
              "announced",
              "source-only",
              "removed",
              "unknown"
            ]
          },
          "delivery": {
            "enum": [
              "native",
              "official-integration",
              "community-integration",
              "manual-workaround",
              "unknown"
            ]
          },
          "scope": {
            "type": "object",
            "properties": {
              "surfaceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "version": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "plan": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "os": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "executionModes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "region": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "harness": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "surfaceIds",
              "version",
              "plan",
              "os",
              "executionModes",
              "region",
              "harness"
            ],
            "additionalProperties": false
          },
          "subanswers": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "support": {
                  "enum": [
                    "supported",
                    "partial",
                    "unsupported",
                    "unknown",
                    "not-applicable"
                  ]
                },
                "answer": {
                  "type": "string",
                  "minLength": 1
                },
                "evidenceIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "support",
                "answer",
                "evidenceIds"
              ],
              "additionalProperties": false
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "unknownReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "checkedAt": {
            "type": "string",
            "format": "date"
          },
          "nextReviewAt": {
            "type": "string",
            "format": "date"
          },
          "researcher": {
            "type": "string",
            "minLength": 1
          },
          "publication": {
            "enum": [
              "internal-only",
              "public-candidate",
              "public-reviewed"
            ]
          },
          "review": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "reviewer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "date": {
                    "type": "string",
                    "format": "date"
                  },
                  "contentHash": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "reviewer",
                  "date",
                  "contentHash"
                ],
                "additionalProperties": false
              }
            ]
          },
          "contradictions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "criterionId",
          "answer",
          "support",
          "availability",
          "delivery",
          "scope",
          "subanswers",
          "limitations",
          "unknownReason",
          "evidenceIds",
          "checkedAt",
          "nextReviewAt",
          "researcher",
          "publication",
          "review",
          "contradictions"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "observed",
              "source-inspected",
              "documented",
              "vendor-claimed",
              "unresolved"
            ]
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(https?://[^\\s]+|internal-file:[^\\s]+)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "sourceDate": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "retrievedAt": {
            "type": "string",
            "format": "date"
          },
          "finding": {
            "type": "string",
            "minLength": 1
          },
          "visibility": {
            "enum": [
              "public",
              "internal"
            ]
          },
          "commit": {
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "configuration": {
            "type": "string",
            "minLength": 1
          },
          "fixture": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "url",
          "title",
          "locator",
          "sourceDate",
          "retrievedAt",
          "finding",
          "visibility",
          "commit",
          "path"
        ],
        "additionalProperties": false
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "author": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "initial-research",
              "product-change",
              "research-correction",
              "rubric-change",
              "freshness-recheck"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "claimIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "before": {},
          "after": {},
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "date",
          "author",
          "type",
          "summary",
          "claimIds"
        ],
        "additionalProperties": false
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "roadmapReview": {
          "type": "object",
          "properties": {
            "checkedAt": {
              "type": "string",
              "format": "date"
            },
            "locations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": ["string", "null"]
                  },
                  "result": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["url", "result"],
                "additionalProperties": false
              }
            },
            "announced": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "criterionId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sourceDate": {
                    "anyOf": [
                      { "type": "string", "format": "date" },
                      { "type": "null" }
                    ]
                  },
                  "targetDate": {
                    "anyOf": [
                      { "type": "string", "format": "date" },
                      { "type": "null" }
                    ]
                  },
                  "evidenceIds": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  }
                },
                "required": ["criterionId", "summary", "sourceDate", "targetDate", "evidenceIds"],
                "additionalProperties": false
              }
            },
            "gaps": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "required": ["checkedAt", "locations", "announced", "gaps"],
          "additionalProperties": false
        }
      }
    },
    "lifecycle": {
      "description": "Optional scoped lifecycle finding. Omission means unknown, never active. Independent review is bound to the factual fields and cited evidence.",
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "unknown",
            "sunset"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "continuation": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "announcementDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "serviceEndDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "checkedAt": {
          "type": "string",
          "format": "date"
        },
        "nextReviewAt": {
          "type": "string",
          "format": "date"
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "researcher": {
          "type": "string",
          "minLength": 1
        },
        "publication": {
          "enum": [
            "internal-only",
            "public-candidate",
            "public-reviewed"
          ]
        },
        "contradictions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "review": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "reviewer": {
                  "type": "string",
                  "minLength": 1
                },
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "contentHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "reviewer",
                "date",
                "contentHash"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "status",
        "note",
        "scope",
        "continuation",
        "announcementDate",
        "serviceEndDate",
        "checkedAt",
        "nextReviewAt",
        "evidenceIds",
        "researcher",
        "publication",
        "contradictions",
        "review"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "rubricVersion",
    "id",
    "name",
    "category",
    "researchTier",
    "researchState",
    "identity",
    "surfaces",
    "claims",
    "evidence",
    "changes",
    "context"
  ],
  "additionalProperties": false
}
