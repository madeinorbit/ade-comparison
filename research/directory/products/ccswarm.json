    "rationale": "Team-leader flow has a product-owned leader stage that spawns and aggregates worker stages.",
    "researcher": "researcher-batch17",
    "contentHash": "de73fab5872ef0e69a1d1855d8a221901a5697bf46866673f348556753c37584",
