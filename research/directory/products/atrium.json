  "telemetry-default": {
    "value": "on-by-default",
    "claimId": "atrium:OWN-03",
    "evidenceIds": [
      "atrium:telemetry"
    ],
    "checkedAt": "2026-11-26",
    "rationale": "The telemetry documentation says Tier 1 core lifecycle and setup events are sent to PostHog by default whenever telemetry.enabled is true, which is the shipped default; detailed analytics and Sentry crash reports stay off until the user chooses Share usage & crash reports. The default core events alone make telemetry on by default. Coding-provider traffic and local diagnostics are separate.",
    "researcher": "agent:ADE-209",
    "contentHash": "181c510af9807fb530a35391156b04529de2e821aaa8a64a950079a1084ec8b4",
    "review": {
