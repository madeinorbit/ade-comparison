      "reviewer": "agent:ADE-188",
      "date": "2026-11-26",
      "contentHash": "181c510af9807fb530a35391156b04529de2e821aaa8a64a950079a1084ec8b4"
    }
  },
  "telemetry-off-switch": {
    "value": "in-app",
    "claimId": "atrium:OWN-03",
    "evidenceIds": [
      "atrium:telemetry"
    ],
    "checkedAt": "2026-11-26",
    "rationale": "The documented master switch is Send nothing in Settings > Privacy & data; the documentation says atrium then sends nothing to PostHog or Sentry. telemetry.enabled=false in config.json is the configuration equivalent. Core only is not a complete switch because lifecycle events still flow.",
    "researcher": "agent:ADE-209",
    "contentHash": "671c7859c1674f56c57c47c7ad3713ec5a48f6dbfee25ff259bdef29995650ca",
