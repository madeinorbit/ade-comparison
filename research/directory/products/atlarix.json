  "telemetry-default": {
    "value": "on-by-default",
    "claimId": "atlarix:OWN-03",
    "evidenceIds": [
      "atlarix:review-privacy",
      "atlarix:review-telemetry",
      "atlarix:review-editor-source"
    ],
    "checkedAt": "2026-11-26",
    "rationale": "The current privacy policy says desktop, CLI and VS Code editor extension product analytics are on by default, and that crash reports and signed-in client usage reports are sent regardless of the analytics choice. The published 15.19.5 runtime treats unset consent as enabled when a PostHog key is supplied and queues signed-in usage reports unless ATLARIX_HOST_TELEMETRY=off. The older Security page wording of opt-in analytics is kept in the finding. The Chrome 15.19.4 extension has no separate analytics client and an accountless batch run has no sending session. Provider requests, Core billing records and local logs are not telemetry.",
    "researcher": "agent:ADE-209",
    "contentHash": "5379d1f4ef0d772fcbf3e93b473f8ea6eef9f3f88b6528d1b73718353bcd8fe9",
    "review": {
      "state": "accepted",
