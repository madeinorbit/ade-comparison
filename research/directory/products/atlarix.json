      "date": "2026-11-26",
      "contentHash": "5379d1f4ef0d772fcbf3e93b473f8ea6eef9f3f88b6528d1b73718353bcd8fe9"
    }
  },
  "telemetry-off-switch": {
    "value": "in-app",
    "claimId": "atlarix:OWN-03",
    "evidenceIds": [
      "atlarix:review-privacy",
      "atlarix:review-editor-source"
    ],
    "checkedAt": "2026-11-26",
    "rationale": "Scoped to the VS Code editor extension client: turning off VS Code's telemetry setting in the editor's settings interface stops Atlarix analytics, crash reports and signed-in usage reports, per the privacy policy, and the published 15.19.5 extension binds that setting to ATLARIX_HOST_TELEMETRY=off and a live _atlarix/host_telemetry change. In the desktop app and CLI, Settings and /analytics stop product analytics only, so no complete desktop or CLI interface switch is established; the signed-in Node batch runtime is controlled only by the ATLARIX_HOST_TELEMETRY=off environment variable.",
    "researcher": "agent:ADE-209",
    "contentHash": "5a103f0822147d01e12b8b296dd4ccce0cf7a5ecd7f84bfd32cc2ef7860558c1",
