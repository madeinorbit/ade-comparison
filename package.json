{
  "name": "ade-comparison",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "node scripts/validate-data.mjs && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/*.test.ts",
    "test:research": "node --test --test-concurrency=1 research/*.test.mjs research/screenshots/*.test.mjs research/publication/*.test.mjs",
    "test:browser": "playwright test",
    "screenshots:import": "node scripts/import-screenshots.mjs",
    "data:build": "node research/directory/build.mjs",
    "data:check": "node research/directory/build.mjs --check",
    "research:validate": "node research/validate.mjs",
    "test:lighthouse": "node scripts/lighthouse.mjs",
    "test:portable": "node scripts/verify-portable.mjs"
  },
  "dependencies": {
    "astro": "6.4.4",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.61.0",
    "chrome-launcher": "1.2.3",
    "lighthouse": "13.6.0",
    "typescript": "6.0.3",
    "wrangler": "4.136.3",
    "yaml": "2.9.1"
  },
  "overrides": {
    "playwright-core": "1.61.0"
  }
}
