---
import Layout from '../../layouts/Layout.astro'
import Comparison from '../../components/Comparison.astro'
import { pairs } from '../../lib/data'
---
<Layout title="Compare 2 to 4 ADEs" description="Compare ADEs side by side with screenshots and public finding receipts. Share your selection by URL.">
  <div class="in page">
    <h1>Compare ADEs</h1>
    <p class="page-lead">Up to four side by side. Add one from an empty column, remove one from its heading. The address keeps your choice, so you can share it.</p>
    <Comparison mode="compare" />
    <section id="pairs"><h2>Pair comparisons</h2><p>These pages also work without JavaScript. <a href="/method/#pairs">How we select pairs</a>.</p>
      <details class="pairs"><summary>All {pairs.length} pairs</summary><ul class="listing-list">{pairs.map(pair => <li><a href={`/compare/${pair.slug}/`}>{pair.products.map(p => p.name).join(' vs ')}</a></li>)}</ul></details>
    </section>
  </div>
</Layout>
