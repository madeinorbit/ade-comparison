---
import { checkedAge, mayBeOutdated } from '../lib/age'
interface Props { date: string | null | undefined }
const { date } = Astro.props
---
{date && <small class="checked-age"><time datetime={date} data-checked-at={date} title={`Checked ${date}`}>{checkedAge(date)}</time>{mayBeOutdated(date) && <span data-outdated> · may be outdated</span>}</small>}
