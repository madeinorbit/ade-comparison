---
// The sorting board in miniature: three words get pressed, and the ADEs drop into their fields, one field at a time.
// Decorative; the page says the same thing in words. Plays once, and holds still under reduced motion.
const fits = [[12, 62], [104, 62], [12, 120], [104, 120], [12, 178], [104, 178]]
const kind = [[214, 62], [214, 98], [214, 134], [214, 170]]
const closing = [[330, 62], [330, 98]]
---
<svg class="hero-board" viewBox="0 0 400 236" role="img" aria-label="Three words pressed, and ADE cards dropping into three fields: Fits, Fits kind of, and Fits but shutting down.">
  <g class="hb-words" font-size="13" font-weight="500">
    <text x="0" y="14">Claude Code</text><rect class="hb-u" style="--i:0" x="0" y="20" width="76" height="2.5" />
    <text x="96" y="14">Phone</text><rect class="hb-u" style="--i:1" x="96" y="20" width="38" height="2.5" />
    <text x="154" y="14">Laptop closed</text><rect class="hb-u" style="--i:2" x="154" y="20" width="88" height="2.5" />
  </g>
  <rect class="hb-fits" x="0" y="40" width="200" height="196" />
  <rect class="hb-kind" x="204" y="40" width="112" height="196" />
  <rect class="hb-close" x="320" y="40" width="80" height="196" />
  <g class="hb-drop" style="--i:0">{fits.map(([x, y]) => <g transform={`translate(${x} ${y})`}><rect width="84" height="50" class="hb-paper" /><rect width="84" height="7" class="hb-top" /><rect x="8" y="16" width="44" height="4" class="hb-line" /><rect x="8" y="25" width="62" height="3" class="hb-faint" /><rect x="8" y="33" width="52" height="3" class="hb-faint" /></g>)}</g>
  <g class="hb-drop" style="--i:1">{kind.map(([x, y]) => <g transform={`translate(${x} ${y})`}><rect width="92" height="28" class="hb-paper" /><rect width="26" height="28" class="hb-shot" /><rect x="32" y="8" width="40" height="4" class="hb-line" /><rect x="32" y="17" width="52" height="3" class="hb-faint" /></g>)}</g>
  <g class="hb-drop" style="--i:2">{closing.map(([x, y]) => <g transform={`translate(${x} ${y})`}><rect width="60" height="28" class="hb-paper" /><rect x="6" y="9" width="10" height="10" class="hb-mark" /><rect x="22" y="9" width="30" height="4" class="hb-line" /><rect x="22" y="17" width="22" height="3" class="hb-faint" /></g>)}</g>
</svg>
<style is:global>
  .hero-board { width: 100%; max-width: 400px; height: auto; overflow: visible; }
  .hb-words { fill: var(--ink); font-family: var(--font); }
  .hb-u { fill: var(--mark); transform-box: fill-box; transform-origin: left; animation: hb-press 320ms var(--ease-out) both; animation-delay: calc(80ms + var(--i) * 110ms); }
  .hb-fits { fill: var(--field); }
  .hb-kind { fill: var(--paper-2); }
  .hb-close { fill: var(--paper-3); }
  .hb-paper { fill: var(--paper); }
  .hb-top { fill: var(--ink); }
  .hb-shot { fill: var(--paper-3); }
  .hb-line { fill: var(--ink-2); }
  .hb-faint { fill: var(--rule); }
  .hb-mark { fill: var(--mark); }
  .hb-drop { animation: hb-drop 520ms var(--ease-out) both; animation-delay: calc(420ms + var(--i) * 90ms); }
  @keyframes hb-press { from { transform: scaleX(0); } }
  @keyframes hb-drop { from { opacity: 0; translate: 0 -28px; } }
</style>
