---
// One ADEMark section per benchmarked ADE: every measured value, with a single credit for the source.
import { ademarkCount, ademarkMeasured, ademarkSetup, ademarkSource, ademarkStale, benchApp, benchCell, benchTests, ordinal } from '../lib/benchmarks'
interface Props { productId: string; name: string }
const { productId, name } = Astro.props
const app = benchApp(productId)
const groups = [...new Set(benchTests.map(t => t.group))]
---
{app && <section class="bench" id="ademark" aria-labelledby={`bench-${productId}`}>
  <header class="bench-head">
    <h2 id={`bench-${productId}`}>Measured by ADEMark</h2>
    <p class="bench-credit">
      <a href={ademarkSource.url} rel="noopener noreferrer">ADEMark</a> ran the same tests on {ademarkCount} ADEs. Results for {`${name} ${app.version}`}, measured up to {ademarkMeasured} on a {ademarkSetup}.
      Data <a href={ademarkSource.licenseUrl} rel="noopener noreferrer">{ademarkSource.license}</a>, shown unchanged{ademarkStale() && <strong> · may be outdated: ADEMark marks results stale after 60 days</strong>}.
    </p>
  </header>
  <div class="bench-grid">{groups.map(group => <div class="bench-group">
    <h3>{group}</h3>
    <dl>{benchTests.filter(t => t.group === group).map(test => { const c = benchCell(productId, test); return <div class={`bench-row is-${c.kind}`}>
      <dt>{test.label}</dt>
      <dd>
        <span class="bench-v">{c.text}</span>
        {c.rank && <span class="bench-rank">{ordinal(c.rank)} of {c.of}</span>}
        <small>{c.kind === 'value' ? <>{c.runs === 1 ? '1 run' : `median of ${c.runs} runs`}{c.range && `, ${c.range}`}{c.control && <> · <span class="nw">Bare CLI {c.control}</span></>}</> : c.cause && `ADEMark: ${c.cause}`}</small>
      </dd>
    </div> })}</dl>
  </div>)}</div>
  <p class="bench-foot">Place counts only apps with a value; lower is better except passed tests. ADEMark publishes no overall score and treats close medians as ties, so read places as an order, not a verdict. The Bare CLI is Claude Code in a terminal, run as an unranked control. <a href={ademarkSource.url} rel="noopener noreferrer">Method and every test on ademark.dev</a> · <a href="/benchmarks/ademark.json">Imported data</a> · <a href="/method/#benchmarks">How we use it</a></p>
</section>}
<style>
  .bench { display: grid; gap: var(--s-lg); border-top: 2px solid var(--ink); padding-top: var(--s-lg); }
  .bench-head { display: grid; gap: var(--s-xs); }
  .bench h2 { font-size: var(--t-3xl); }
  .bench-credit { color: var(--ink-2); max-width: 72ch; font-size: var(--t-sm); }
  .bench-credit strong { font-weight: 500; color: var(--ink); }
  .bench-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-xl) var(--gap); }
  .bench-group h3 { font: 500 var(--t-xs)/1 var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--muted); padding-bottom: var(--s-xs); border-bottom: 1px solid var(--ink); }
  .bench-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: var(--s-md); padding-block: var(--s-xs); border-bottom: 1px solid var(--rule); }
  .bench-row dt { color: var(--ink-2); font-size: var(--t-sm); }
  .bench-row dd { margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 var(--s-sm); }
  .bench-v { font-weight: 600; font-variant-numeric: tabular-nums; }
  .bench-rank { font: 500 var(--t-xs)/1.4 var(--mono); color: var(--ink-2); }
  .bench-row small { flex-basis: 100%; color: var(--muted); font-size: var(--t-xs); }
  .nw { white-space: nowrap; }
  .is-gap .bench-v { font-weight: 400; color: var(--ink-2); }
  .bench-foot { font-size: var(--t-xs); color: var(--muted); max-width: 90ch; }
  @media (max-width: 48rem) { .bench-grid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 30rem) { .bench-row { grid-template-columns: minmax(0, 1fr); gap: 0; } }
</style>
