---
// The ADE sheet: the top of an ADE page, and the whole of the dialog that opens from the Finder.
import type { Product } from '../lib/types'
import Screenshot from './Screenshot.astro'
import Lifecycle from './Lifecycle.astro'
import Checked from './Checked.astro'
import { cellFor, claimAnchor, requirements, stats } from '../lib/data'
import { facts, summary, shotFor, noticeFor, hostname, shutdownLine } from '../lib/sheet'
import { submissionLinks } from '../lib/submissions'
interface Props { product: Product; mode: 'page' | 'dialog' }
const { product, mode } = Astro.props
const researched = product.researchStatus === 'covered'
const notice = noticeFor(product.id)
const shot = shotFor(product.id)
const page = `/ade/${product.id}/`
// In the dialog every in-page link points at the full page, which holds the receipts.
const at = (hash: string) => mode === 'dialog' ? `${page}#${hash}` : `#${hash}`
// Yes, no or unknown per requirement, so a selection can be read against this ADE in the browser.
const answers: Record<string, 'y' | 'n'> = {}
for (const req of requirements) {
  if (req.facetId === 'lifecycle-status') continue
  const cell = cellFor(product, req), v = cell.value
  if (v === 'unknown') continue
  const single = !['yes', 'no'].includes(v)
  const yes = single ? (req.anyOf ? req.anyOf.includes(`${req.facetId}:${v}`) : v === req.option) : v === 'yes'
  answers[req.key] = yes ? 'y' : 'n'
}
// The findings people read first, under plain titles, with the requirement keys each one speaks to.
const story: [string, string, string[]][] = [
  ['ACC-01', 'Where you use it', ['any-desktop', 'desktop-os:macos', 'desktop-os:windows', 'desktop-os:linux', 'web-client', 'any-phone-client', 'phone-client:ios', 'phone-client:android', 'phone-client:mobile-web', 'cli']],
  ['ACC-02', 'Agents it runs', ['agents:codex', 'agents:claude-code', 'agents:cursor', 'agents:opencode', 'agents:gemini-cli', 'agents:pi', 'agents:grok', 'agents:aider']],
  ['ACC-03', 'Accounts and subscriptions', ['byo-subscription']],
  ['RUN-01', 'Where agents run', ['execution:local', 'execution:own-server', 'execution:vendor-cloud', 'laptop-independent']],
  ['RUN-02', 'How work is kept apart', ['isolation:worktree', 'isolation:container', 'isolation:vm']],
  ['COORD-01', 'Parallel work', ['parallel-runs']],
  ['COORD-04', 'Scheduled runs', ['unattended-triggers']],
  ['SHIP-03', 'Git and pull requests', ['pr-workflow']],
  ['OWN-01', 'Licence and source', ['open-source-license', 'self-hosting']],
  ['OWN-04', 'Price', ['free-tier']],
].flatMap(([id, title, keys]) => {
  const claim = product.claims?.find(c => c.claimId === `${product.id}:${id}`)
  return claim && claim.answer && claim.support !== 'unknown' ? [[`${product.id}:${id}`, title as string, keys as string[]]] : []
})
const claimText = (id: string) => product.claims!.find(c => c.claimId === id)!.answer
const hosts = [...new Set((product.sources || []).map(s => hostname(s.url)))]
const crossChecked = (product.claims || []).filter(c => c.verificationStatus === 'agent-cross-checked').length
const links = submissionLinks({ product, pagePath: page })
const site = product.website ? hostname(product.website) : null
---
<div class={`sheet sheet-${mode}`} data-sheet={product.id} data-name={product.name} data-answers={JSON.stringify(answers)} data-closing={notice ? 'true' : undefined}>
  {notice && <section id="lifecycle" class="sheet-close" aria-labelledby="lifecycle-title"><h2 id="lifecycle-title">Shutdown notice</h2><p class="sheet-when">{shutdownLine(notice)}</p><Lifecycle productId={product.id} compact /></section>}
  <header class="sheet-head">
    <h1 id={`sheet-title-${product.id}`} tabindex="-1">{product.name}</h1>
    {researched && <p class="sheet-lead">{summary(product)}</p>}
    <div class="sheet-fit" data-sheet-fit hidden><p class="sheet-verdict" data-verdict></p><ul class="fit" data-fit></ul></div>
    <p class="sheet-act">
      {product.website && <a class="btn-ink" href={product.website} rel="noopener noreferrer">Product website<span class="sheet-host">{site}</span></a>}
      {researched && (mode === 'dialog'
        ? <button type="button" class="btn-line add" data-compare={product.id} aria-pressed="false"><span class="add-box" aria-hidden="true"></span>Compare<span class="vh"> {product.name}</span></button>
        : <a class="btn-line" href={`/compare/?products=${product.id}`} data-compare-link>Compare with others</a>)}
      
    </p>
  </header>
  {(researched || shot) && <div class="sheet-main">
    <Screenshot productId={product.id} name={product.name} caption={!researched} eager={mode === 'page'} />
    {researched && <dl class="facts">{facts(product).map(f => <div data-keys={f.keys.join(' ')} class={f.value ? (f.no ? 'is-no' : '') : 'is-quiet'}><dt>{f.label}</dt><dd>{f.value ?? 'Not listed'}</dd></div>)}</dl>}
  </div>}
  {researched && <section class="receipts" aria-labelledby={`receipts-${product.id}`}>
    <h2 id={`receipts-${product.id}`}>Receipts</h2>
    <dl>
      <div><dt>Checked</dt><dd><time datetime={product.lastCheckedAt || undefined}>{product.lastCheckedAt}</time> <Checked date={product.lastCheckedAt} />{product.oldestCheckedAt && product.oldestCheckedAt !== product.lastCheckedAt && <span class="r-dim"> · oldest answer {product.oldestCheckedAt}</span>}</dd></div>
      <div><dt>Findings</dt><dd>{product.claims?.length || 0} published · {crossChecked} cross-checked by a second agent · <a href={at('findings')}>read them all</a></dd></div>
      <div><dt>Sources</dt><dd>{product.sources?.length || 0} public pages on {hosts.length} {hosts.length === 1 ? 'site' : 'sites'}: {hosts.slice(0, 4).join(', ')}{hosts.length > 4 && <span class="r-dim"> and {hosts.length - 4} more</span>}</dd></div>
      <div><dt>Screenshot</dt><dd>{shot ? <><a href={shot.sourcePage} rel="noopener noreferrer">{hostname(shot.sourcePage)}</a>, retrieved <time datetime={shot.retrievedAt}>{shot.retrievedAt}</time> · {shot.provenance.replace(/-/g, ' ')} · shows appearance, not capability</> : 'None accepted yet'}</dd></div>
      <div><dt>Data</dt><dd><a href={`/products/${product.id}.json`}>/products/{product.id}.json</a> · <a href={`/products/${product.id}.md`}>.md</a></dd></div>
      <div><dt>Method</dt><dd>Same rules for all {stats.researched} researched ADEs. <a href="/method/">How we check</a>{links && <> · <a href={links.reportWrongData} rel="noopener noreferrer">Report wrong data</a></>}</dd></div>
    </dl>
  </section>}
  {story.length > 0 && <section class="story" aria-labelledby={`story-${product.id}`}>
    <h2 id={`story-${product.id}`}>What it does</h2>
    <div class="claims">{story.map(([id, title, keys]) => <div class="claim" data-keys={keys.join(' ')}><h3>{title}</h3><p>{claimText(id)}</p><a href={at(claimAnchor(id))}>Source and scope<span class="vh"> for {title}</span></a></div>)}</div>
  </section>}
</div>
